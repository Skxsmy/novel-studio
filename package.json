{
  "name": "novel-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build:packages",
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @novel-studio/server",
    "dev:web": "npm run dev -w @novel-studio/web",
    "build:packages": "npm run build -w @novel-studio/contracts && npm run build -w @novel-studio/ai && npm run build -w @novel-studio/storage",
    "build": "npm run build:packages && npm run build -w @novel-studio/server && npm run build -w @novel-studio/web",
    "typecheck": "npm run build:packages && npm run typecheck --workspaces --if-present",
    "test": "npm run build:packages && npm run test --workspaces --if-present",
    "test:smoke": "npm run test:smoke -w @novel-studio/storage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:quick": "playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "probe:ns605": "node scripts/ns-605-retrieval-probe.mjs",
    "probe:ns607": "node scripts/ns-607-workshop-research-harness.mjs",
    "probe:ns607:behavior": "node scripts/ns-607-workshop-behavior-harness.mjs",
    "fixture:ns607-browser": "node scripts/ns-607-browser-fixture-server.mjs",
    "test:harness:ns607": "node --test scripts/harness/workshop-behavior-harness.test.mjs",
    "test:docs": "node --test tests/docs/docs-check.test.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "start": "npm run start -w @novel-studio/server",
    "check": "npm run docs:check && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
